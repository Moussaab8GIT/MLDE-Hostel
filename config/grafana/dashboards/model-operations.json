{
  "uid": "hotel-model-operations",
  "title": "Hotel Model and Training Operations",
  "tags": ["mlops", "model-quality"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "text", "title": "How to read model quality",
     "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
     "options": {"mode": "markdown", "content": "Scores use feedback received in the last 30 days, grouped by the model that made each prediction. Precision, recall and F1 are absent until a version has at least 30 labels and both actual classes. No data means insufficient feedback, not zero accuracy. Feedback can be selective: these scores are not an unbiased evaluation. Historical test scores remain in MLflow. Training panels observe reports written after this feature was added."}},
    {"id": 2, "type": "stat", "title": "Feedback count by version (30 days)",
     "gridPos": {"h": 5, "w": 12, "x": 0, "y": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "model_feedback_count", "legendFormat": "v{{model_version}}", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "short", "noValue": "No feedback yet"}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Precision, recall and F1 by version",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "model_feedback_precision", "legendFormat": "Precision v{{model_version}}"},
                 {"expr": "model_feedback_recall", "legendFormat": "Recall v{{model_version}}"},
                 {"expr": "model_feedback_f1", "legendFormat": "F1 v{{model_version}}"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "noValue": "Insufficient feedback"}, "overrides": []}},
    {"id": 4, "type": "stat", "title": "Last recorded training result (1=completed, 0=failed)",
     "gridPos": {"h": 5, "w": 12, "x": 0, "y": 9},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "training_last_success", "instant": true}],
     "fieldConfig": {"defaults": {"noValue": "No recorded run yet"}, "overrides": []}},
    {"id": 5, "type": "stat", "title": "Last training duration",
     "gridPos": {"h": 5, "w": 6, "x": 12, "y": 12},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "training_last_duration_seconds", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 6, "type": "stat", "title": "Recorded training failures",
     "gridPos": {"h": 5, "w": 6, "x": 18, "y": 12},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "training_failures_recorded", "instant": true}]},
    {"id": 7, "type": "table", "title": "Active operational alerts",
     "gridPos": {"h": 6, "w": 12, "x": 0, "y": 14},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "ALERTS{alertstate=\"firing\",alertname=~\"Hotel.*\"}", "instant": true, "format": "table"}]}
  ]
}
